shader_type spatial;
// --- CRITICAL RENDER MODES ---
// 1. unshaded: Gives it the flat color look.
// 2. depth_draw_opaque: FORCES the object into the OPAQUE queue.
// 3. alpha_to_coverage: Reduces jaggedness on the cut-out edges.
render_mode unshaded, depth_draw_opaque, alpha_to_coverage; 

uniform vec4 albedo : source_color = vec4(0.2, 0.4, 0.8, 1.0); // Default Blue
// We still use a sampler, but you can set a default white texture or a simple pattern for movement
uniform sampler2D texture_albedo : source_color, filter_nearest; 

// The 'texture' is generated by calculation:
uniform float voxel_size = 64.0; // Defines the grid for the internal pattern (not the screen)
uniform vec2 uv_scale = vec2(1.0, 1.0);
uniform vec2 uv_offset = vec2(0.0, 0.0);
uniform float alpha_scissor_threshold : hint_range(0.0, 1.0) = 0.5;

void fragment() {
    // 1. Scale and Offset the UVs for movement
    vec2 scaled_uv = UV * uv_scale;
    vec2 moving_uv = scaled_uv + uv_offset;
    
    // 2. The Magic: Procedural Voxel-Style Pattern (What you called the 'texture')
    // This creates the sharp, blocky look *within* the water.
    vec2 pattern_uv = floor(moving_uv * voxel_size) / voxel_size;
    
    // **KEY CHANGE**: We use the calculated pattern UV to sample the texture, 
    // but if you have no texture, you can use a constant color and still apply the pattern.
    vec4 tex_color = texture(texture_albedo, pattern_uv);
    
    // Mix pattern color with the uniform albedo color
    ALBEDO = tex_color.rgb * albedo.rgb;
    ALPHA = tex_color.a * albedo.a;
    
    // 3. Force Alpha Cutout (Crucial for Opaque Draw)
    // Any pixel with alpha below the threshold is discarded completely (invisible).
    // This is what allows 'depth_draw_opaque' to work for objects with transparency.
    ALPHA_SCISSOR_THRESHOLD = alpha_scissor_threshold;
}