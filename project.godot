[layer_names]

3d_render/layer_1="MainLayer"
3d_render/layer_2="HackingLayer"
3d_render/layer_3="player"
3d_render/layer_4="WeaponsLayer"
3d_physics/layer_1="Land"
3d_physics/layer_2="player"
3d_physics/layer_4="ItemsGrap"
3d_physics/layer_8="ItemsCollect"
3d_physics/layer_9="Ladders"
3d_physics/layer_10="water"
3d_physics/layer_12="Edges"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
shading/overrides/force_vertex_shading=true
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/screen_space_roughness_limiter/enabled=false
textures/default_filters/texture_mipmap_bias=-1.0

[shader_globals]

resolution={
"type": "vec2",
"value": Vector2(640, 480)
}
color_depth={
"type": "float",
"value": 16.0
}
