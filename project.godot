; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="001 - Basic Setup"
run/main_scene="res://levels/level_001.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ItemDatabase="*res://controllers/scripts/InventorySystem/ItemDatabase.gd"
CogitoGlobals="*res://addons/cogito/cogito_globals.gd"
CogitoSceneManager="*res://addons/cogito/SceneManagement/cogito_scene_manager.gd"
CogitoQuestManager="*res://addons/cogito/QuestSystem/cogito_quest_manager.gd"
MenuTemplateManager="*res://addons/cogito/EasyMenus/Nodes/menu_template_manager.tscn"
InputHelper="*res://addons/input_helper/input_helper.gd"
Audio="*res://addons/quick_audio/./Audio.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
InputActions="*res://controllers/UI/input_actions.gd"
Engine_effects="*res://Scripts/engine_effects.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/MagicaVoxel_Importer_with_Extensions/plugin.cfg", "res://addons/RadialMenu/plugin.cfg", "res://addons/anim_player_refactor/plugin.cfg", "res://addons/buff_er/plugin.cfg", "res://addons/cogito/plugin.cfg", "res://addons/customizableCrosshair/plugin.cfg", "res://addons/glue/plugin.cfg", "res://addons/input_helper/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/quick_audio/plugin.cfg", "res://addons/stairs/plugin.cfg", "res://addons/voronoishatter/plugin.cfg")

[global_group]

Player=""
Enemy=""

